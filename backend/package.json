    "admin:promote": "node scripts/promote_admin.js",
    "db:migrate:status": "node scripts/schema-migrate.js status",
    "db:migrate:preflight": "node scripts/schema-migrate.js preflight",
    "db:migrate:apply": "node scripts/schema-migrate.js apply",
    "db:migrate:postcheck": "node scripts/schema-migrate.js postcheck",
    "check": "node --check src/server.js"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@alicloud/captcha20230305": "^1.1.4",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "opencc-js": "1.4.1",
    "tencentcloud-sdk-nodejs": "^4.0.0",
    "ws": "^8.19.0",
    "zod": "3.25.76"
  },
