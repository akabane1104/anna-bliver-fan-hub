DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fan_hub
DB_PASSWORD=replace_me
DB_NAME=anna_bliver_fan_hub
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=24h
NODE_ENV=development
PORT=5000
TRUST_PROXY=0
REQUEST_BODY_LIMIT=4mb
CORS_ORIGIN=http://localhost:3000

# Site defaults. Admin database settings override these values.
SITE_TITLE=小猪anna的秘密基地
SITE_BRAND_MODE=image
SITE_BRAND_TEXT=小猪anna的秘密基地
SITE_LOGO_URL=/annapiggy-logo.png
SITE_FAVICON_URL=/favicon.ico
CREATOR_DISPLAY_NAME=小猪anna
BILIBILI_UID=
VIEWER_IDENTITY_PROVIDER=
VIEWER_IDENTITY_PROVIDER_KILL_SWITCH=false
VIEWER_IDENTITY_TARGET_ANCHOR_UID=24856973
VIEWER_IDENTITY_TARGET_ROOM_ID=1881089295
VIEWER_IDENTITY_RECONCILE_INTERVAL_MS=60000
VIEWER_IDENTITY_FRESHNESS_MS=300000
VIEWER_IDENTITY_SNAPSHOT_CACHE_MS=240000
VIEWER_IDENTITY_DOWNGRADE_CONFIRM_DELAY_MS=1000
VIEWER_IDENTITY_GUARD_PAGE_SIZE=29
VIEWER_IDENTITY_GUARD_MAX_PAGES=500
VIEWER_IDENTITY_HTTP_TIMEOUT_MS=5000
VIEWER_IDENTITY_HTTP_MAX_RETRIES=2
VIEWER_IDENTITY_HTTP_RETRY_BASE_MS=500
VIEWER_IDENTITY_HTTP_MAX_RETRY_AFTER_MS=300000
SITE_HOME_TITLE=欢迎来到小猪anna的秘密基地
SITE_HOME_SUBTITLE=
SITE_ICP_TEXT=
SITE_PUBLIC_SECURITY_TEXT=

# Point settlement. POINTS_ROOM_ID must be set before automatic settlement runs.
POINTS_ROOM_ID=
POINTS_START_AT=2026-01-01T00:00:00+08:00
POINTS_COIN_PER_POINT=100

# Optional outbound Bot WebSocket client.
BOT_WS_URL=
BOT_WS_TOKEN=

# Optional Bilibili API cookie for server-side public profile refresh only.
BILIBILI_COOKIE=

# Live Control Event API is disabled by default. Keep the ingest and reference
# secrets independent; both require at least 32 bytes when used.
LIVE_EVENT_INGEST_ENABLED=false
LIVE_EVENT_INGEST_SECRET=
LIVE_EVENT_MAX_SKEW_SECONDS=300
LIVE_EVENT_ALLOWED_TARGETS=
LIVE_EVENT_REF_SECRET=

# Optional Aliyun captcha. Enabled only when all four values are present.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_PREFIX=

# Optional Tencent SES. Email verification is enabled only when both secrets,
# SES_FROM_EMAIL, and SES_TEMPLATE_ID are all present (four required values total). Leave them blank to register
# without email verification. Notification templates/targets are independently optional.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=小猪anna的秘密基地
SES_TEMPLATE_ID=
SES_REDEMPTION_TEMPLATE_ID=
SES_REDEMPTION_TO_EMAIL=
SES_MARSHMALLOW_TEMPLATE_ID=
SES_MARSHMALLOW_TO_EMAIL=

# Required only by npm run seed:demo.
DEMO_ADMIN_PASSWORD=
