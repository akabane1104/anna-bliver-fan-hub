# Docker Compose 项目与本机端口
COMPOSE_PROJECT_NAME=anna-bliver-fan-hub
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=5000
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=1
REQUEST_BODY_LIMIT=4mb

# 首次启动前必须替换。也可运行 .\scripts\docker-start.ps1 -Initialize 自动生成。
MYSQL_ROOT_PASSWORD=replace_with_a_unique_local_root_password
MYSQL_PASSWORD=replace_with_a_unique_application_password
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=24h

# 站点默认值。管理后台写入数据库的配置优先级更高。
SITE_TITLE=橙吱_sweety的钢板批发小店
SITE_BRAND_MODE=icon-text
SITE_BRAND_TEXT=橙吱_sweety
SITE_LOGO_URL=/branding/chengzhi-sweety-logo.png
SITE_FAVICON_URL=/favicon.ico
CREATOR_DISPLAY_NAME=橙吱_sweety
BILIBILI_UID=24856973
SITE_HOME_TITLE=欢迎各位霸总来到橙吱钢板批发小店
SITE_HOME_SUBTITLE=养成系全职歌势~
SITE_PLAYLIST_TITLE=橙吱_sweety的歌单
SITE_ICP_TEXT=
SITE_PUBLIC_SECURITY_TEXT=
SITE_PRIMARY_COLOR=#C04D00
SITE_LIGHT_COLOR=#FF8A00
SITE_DARK_COLOR=#803200
SITE_BACKGROUND_COLOR=#FFF8EF
SITE_BACKGROUND_ACCENT_COLOR=#FFE0B2
SITE_TEXT_DARK_COLOR=#362217
SITE_TEXT_LIGHT_COLOR=#6E5747
SITE_BORDER_COLOR=#F0BF83
SITE_SURFACE_COLOR=#ffffff
SITE_SURFACE_MUTED_COLOR=#FFF0DA
SITE_SUCCESS_COLOR=#2E7D57
SITE_WARNING_COLOR=#9A5700
SITE_DANGER_COLOR=#C43D4D

# 积分自动结算。POINTS_ROOM_ID 留空时不会执行自动结算。
POINTS_ROOM_ID=
POINTS_START_AT=2026-01-01T00:00:00+08:00
POINTS_COIN_PER_POINT=100

# Phase 0 全部留空：不连接机器人，不保存或使用真实 B 站 Cookie。
BOT_WS_URL=
BOT_WS_TOKEN=
BILIBILI_COOKIE=

# Live Control Event API 默认关闭。Secret 留空，目标使用 site_id:room_id 的明确配对。
LIVE_EVENT_INGEST_ENABLED=false
LIVE_EVENT_INGEST_SECRET=
LIVE_EVENT_MAX_SKEW_SECONDS=300
LIVE_EVENT_ALLOWED_TARGETS=

# 管理事件 opaque reference 专用密钥；至少 32 bytes，不得与 INGEST/JWT 密钥共用。
# docker-start.ps1 -Initialize 会安全生成；示例保持空白，不可直接用于生产。
LIVE_EVENT_REF_SECRET=

# Phase 0 留空：不启用阿里云 Captcha。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_PREFIX=

# Phase 0 留空：不启用腾讯云 SES。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=橙吱_sweety的钢板批发小店
SES_TEMPLATE_ID=
SES_REDEMPTION_TEMPLATE_ID=
SES_REDEMPTION_TO_EMAIL=
SES_MARSHMALLOW_TEMPLATE_ID=
SES_MARSHMALLOW_TO_EMAIL=

# 仅在明确执行 npm run seed:demo 时临时提供；没有默认管理员密码。
DEMO_ADMIN_PASSWORD=
